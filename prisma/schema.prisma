// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum NotificationType {
  NEXT_BOOKING
}

model User {
  id                     String                   @id @default(cuid())
  name                   String                   @db.VarChar(100)
  email                  String                   @unique @db.VarChar(320)
  passwordHash           String
  emailVerifiedAt        DateTime?                @db.Timestamptz(3)
  emailVerificationToken EmailVerificationToken?
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  bookings               Booking[]
  sessions               Session[]
  recurringBookingSeries RecurringBookingSeries[]
  notifications          Notification[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Room {
  id                     String                   @id @default(cuid())
  name                   String                   @unique @db.VarChar(100)
  floor                  Int
  capacity               Int
  createdAt              DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @db.Timestamptz(3)
  bookings               Booking[]
  bookingSlots           BookingSlot[]
  recurringBookingSeries RecurringBookingSeries[]
}

model Booking {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(100)
  startAt   DateTime @db.Timestamptz(3)
  endAt     DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  userId String
  roomId String

  user  User          @relation(fields: [userId], references: [id])
  room  Room          @relation(fields: [roomId], references: [id])
  slots BookingSlot[]

  recurringSeriesId String?

  recurringSeries RecurringBookingSeries? @relation(fields: [recurringSeriesId], references: [id], onDelete: SetNull)

  notificationsAsCurrent Notification[] @relation("NotificationCurrentBooking")
  notificationsAsNext    Notification[] @relation("NotificationNextBooking")

  @@index([roomId, startAt, endAt])
  @@index([userId, startAt])
  @@index([recurringSeriesId])
}

model BookingSlot {
  bookingId String
  roomId    String
  startsAt  DateTime @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@id([bookingId, startsAt])
  @@unique([roomId, startsAt])
}

model RecurringBookingSeries {
  id              String   @id @default(cuid())
  weekday         Int
  occurrenceCount Int
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  userId String
  roomId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@index([userId, createdAt])
}

model EmailVerificationToken {
  userId    String   @id
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  readAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  userId           String
  currentBookingId String
  nextBookingId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentBooking Booking @relation("NotificationCurrentBooking", fields: [currentBookingId], references: [id], onDelete: Cascade)

  nextBooking Booking @relation("NotificationNextBooking", fields: [nextBookingId], references: [id], onDelete: Cascade)

  @@unique([type, currentBookingId, nextBookingId])
  @@index([userId, readAt, createdAt])
}
